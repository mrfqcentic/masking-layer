PORT=3000

# ------------------------------------------------------------------
# LLM endpoint, option 1: static (explicit OpenAI-compatible endpoint).
# If LLM_BASE_URL is set, instance management is disabled and this
# endpoint is always used.
# ------------------------------------------------------------------
# LLM_BASE_URL=https://your-vllm-endpoint/v1
# LLM_API_KEY=sk-your-api-key

# ------------------------------------------------------------------
# LLM endpoint, option 2: dynamic RunPod instances.
# Leave LLM_BASE_URL unset and set RUNPOD_API_KEY: the server then
# provisions/uses/deletes at most ONE pod, fully on demand:
#   template:  masker (fixed)
#   gpu:       NVIDIA RTX PRO 4500 Blackwell (fixed)
#   location:  EU data centers only; if none has stock, the UI says
#              "No GPU available at the moment"
# The pod's LLM endpoint is derived automatically:
#   base url = https://<podId>-<RUNPOD_LLM_PORT>.proxy.runpod.net/v1
#   api key  = sk-<podId>
# Env vars always win over .env (which is not baked into the image).
# ------------------------------------------------------------------
# RUNPOD_API_KEY=
# RUNPOD_TEMPLATE_ID=upyll5vq6f
# RUNPOD_TEMPLATE_NAME=masker
# RUNPOD_GPU_TYPE_ID=NVIDIA RTX PRO 4500 Blackwell
# RUNPOD_REGION=EUROPE
# RUNPOD_POD_NAME=masking-layer
# RUNPOD_LLM_PORT=8000

# Model id; auto-detected from /v1/models when unset
# MODEL=

LLM_TEMPERATURE=0
LLM_TOP_P=0.95
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=120000
MAX_MESSAGE_CHARS=100000

# INBOUND_API_KEY=